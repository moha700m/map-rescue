# ─────────────────────────────────────────────────────────────
# MAP RESCUE AI — Environment
# ─────────────────────────────────────────────────────────────

# --- AI gateway (required) -----------------------------------
# Single provider for every AI operation. Server-side only.
OPENROUTER_API_KEY=

# --- AI settings storage (optional) --------------------------
# Directory for ai-settings.json / ai-usage.json / encrypted key
AI_DATA_DIR=.data
# Secret used to encrypt a key saved from the admin UI (AES-256-GCM).
# Generate with: openssl rand -hex 32
AI_CONFIG_SECRET=

# Persist settings + usage in Supabase instead of local files
# AI_STORAGE=supabase

# --- Supabase (optional, for the case/app data model) --------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Business Profile OAuth (optional) ----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Scope: https://www.googleapis.com/auth/business.manage
# Project approval required: https://developers.google.com/my-business/content/prereqs

# --- App -----------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
